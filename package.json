{
  "name": "lifeassist-os",
  "version": "0.3.0",
  "private": true,
  "author": "LifeAssistOS",
  "description": "A local-first productivity companion with optional AI coaching, learning, and task planning.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.7.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch@>=7": "^11.0.1"
  },
  "build": {
    "appId": "com.mikeassist.desktop",
    "productName": "LifeAssistOS",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources/app-icon.png",
        "to": "app-icon.png"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "icon": "resources/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LifeAssistOS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LifeAssistOS",
      "deleteAppDataOnUninstall": false
    }
  }
}
