{
  "name": "mike-assist",
  "version": "0.1.0",
  "private": true,
  "author": "Mike Assist",
  "description": "A local-first, permission-gated desktop AI assistant.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "google-auth-library": "^11.3.2",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.7.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.mikeassist.desktop",
    "productName": "Mike Assist",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "src/tools/code-runner-worker.cjs",
        "to": "code-runner-worker.cjs"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Mike-Assist-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mike Assist",
      "deleteAppDataOnUninstall": false
    }
  }
}
